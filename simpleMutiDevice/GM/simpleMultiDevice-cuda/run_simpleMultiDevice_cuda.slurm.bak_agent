#!/bin/bash
#SBATCH -J simpleMultiDevice_cuda
#SBATCH -A ACD115083
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=2
#SBATCH -t 00:10:00
#SBATCH -o result/simpleMultiDevice_cuda_%j.out
#SBATCH -e result/simpleMultiDevice_cuda_%j.err

mkdir -p result

echo "=== Loading modules ==="
module purge
module load cuda/12.8
module list

echo "=== Environment ==="
which nvcc
nvcc --version
hostname
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
nvidia-smi -L

echo "=== Build ==="
make clean || true
make ARCH=sm_70 MAX_GPU=4

echo "=== Run ==="
./main 1000 2>&1 | tee result/simpleMultiDevice_cuda_result_${SLURM_JOB_ID}.txt
