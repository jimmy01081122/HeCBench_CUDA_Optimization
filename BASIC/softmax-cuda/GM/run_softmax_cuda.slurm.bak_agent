#!/bin/bash
#SBATCH -J softmax_cuda
#SBATCH -A ACD115083
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH -t 00:10:00
#SBATCH -o result/softmax_cuda_%j.out
#SBATCH -e result/softmax_cuda_%j.err

mkdir -p result

echo "=== Loading modules ==="
module purge
module load cuda/12.8
module list

echo "=== Environment ==="
which nvcc
nvcc --version
hostname
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
nvidia-smi -L
nvidia-smi

echo "=== Build ==="
make clean || true
make ARCH=sm_70 2>&1

echo "=== Run Baseline ==="
./main 100000 784 0 100 2>&1 | tee -a result/softmax_cuda_result_${SLURM_JOB_ID}.txt
./main 100000 784 1 100 2>&1 | tee -a result/softmax_cuda_result_${SLURM_JOB_ID}.txt
